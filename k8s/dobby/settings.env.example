# Copy to settings.env. No secrets belong in this file.
# Confirm the addresses against the actual cluster before setting this to yes.
CONFIG_VERIFIED=no
DOBBY_CONTEXT=CHANGE_ME
NODE_NAME=bella
TAILNET_DNS=smelt-gray.ts.net
TAILNET_USER=CHANGE_ME@example.com
# Include EVERY cluster node address, public and private, as /32 CIDRs.
NODE_CIDRS=100.96.156.117/32,100.80.19.125/32,10.0.0.6/32
# These match observed pod/service addresses; confirm configured service range.
# Include any additional public node/NAT addresses before deployment.
POD_CIDRS=10.42.0.0/16
SERVICE_CIDRS=10.43.0.0/16
EXTRA_BLOCKED_CIDRS=
BASE_DIR=/srv/dobby
# Use the multi-architecture digest published by ministry's dobby-image workflow.
WORKSPACE_IMAGE=ghcr.io/adi-qtpi/dobby@sha256:CHANGE_ME
# Upstream currently documents preview container publication; pin the build.
RELAY_IMAGE=happierdev/relay-server@sha256:87527bbc4e107e5236da5fb785ef1901fb410bcfc33ca6497c275d3944c73071
DASHBOARD_IMAGE=ghcr.io/gethomepage/homepage@sha256:019d8f063a7299e7c1c51ee4a70b692291809af3244894fbec2c2ac7d1f71b18
# Actual CoreDNS Service address observed on bella's cluster.
DNS_SERVER=10.43.0.10
TAILSCALE_CHART_VERSION=1.104.7
