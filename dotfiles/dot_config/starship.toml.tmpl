# starship.toml — generated by Starship Prompt Builder (https://starship.ndl.au)
# Save to ~/.config/starship.toml (or $STARSHIP_CONFIG).
# Reference: https://starship.rs/config/

format = "[╭─ ](dimmed white)$os$username$hostname$kubernetes$directory$git_branch$git_status$fill $time\n[│](dimmed white)\n[╰─](dimmed white)$character"
right_format = "$battery"
add_newline = true
palette = "solarized"

[palettes.solarized]
blue = "#5fb3ea"
violet = "#6c71c4"
red = "#dc322f"
cyan = "#2aa198"
green = "#859900"
yellow = "#b58900"
orange = "#cb4b16"
gray = "#839496"
gold = "#b28d1e"

[battery]
format = "[$symbol$percentage]($style)"

[[battery.display]]
threshold = 10
style = "bold red"

[[battery.display]]
threshold = 25
style = "bold orange"

[[battery.display]]
threshold = 50
style = "bold yellow"

[[battery.display]]
threshold = 75
style = "bold green"

[[battery.display]]
threshold = 100
style = "bold cyan"

[character]
success_symbol = " [ϟ](bold green)"
error_symbol = " [ϟ](bold red)"

[cmd_duration]
format = "[⏳ $duration]($style) "
style = "dimmed gray"

[directory]
format = "[󰉋 $path]($style) "
style = "bold cyan"

[fill]
symbol = "·"
style = "dimmed white"

[git_branch]
format = "[ $symbol$branch ]($style)"
symbol = ""
style = "bold violet"

[git_status]
format = "[$all_status$ahead_behind]($style) "
style = "bold red"
conflicted = "~"
stashed = "≡"
deleted = "x"

[hostname]
ssh_only = false
format = "[@$hostname ]($style) "
style = "bold gold"

[kubernetes]
format = '[☸ $context\($namespace\)]($style) '
style = "bold blue"

[os]
disabled = false
format = "[$symbol ]($style)"
style = "bold blue"

[os.symbols]
Macos = ""
Ubuntu = ""
Windows = "hey weirdo!"
Fedora = ""
Arch = ""
Unknown = "<unpopularOS>"

[time]
disabled = false
format = "[🦉 $time]($style)"
time_format = "%H:%M:%S"
style = "bold gray"

[username]
show_always = true
format = "[ $user]($style)"
style_user = "bold cyan"
