# Environment Variables
export LANG="C.UTF-8"
export LC_ALL="C.UTF-8"
export EDITOR="nvim"

# Helper Function
add_to_path() {
    [[ -d "$1" && ":$PATH:" != *":$1:"* ]] && export PATH="$1:$PATH"
}

# 1. Base OS Paths First
if [[ "$OSTYPE" == "darwin"* ]]; then
    add_to_path "/opt/homebrew/bin"
    add_to_path "/opt/homebrew/sbin"
    add_to_path "/usr/local/bin"
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    add_to_path "$HOME/.local/bin"
    add_to_path "/usr/local/bin"
fi

# 2. Package Managers & Language Runtimes
add_to_path "$HOME/.npm-global/bin"
add_to_path "$HOME/go/bin"
add_to_path "/usr/local/go/bin"
add_to_path "$HOME/.cargo/bin"

# Shell Aliases
alias cd="z"
alias tf="terraform"
alias k="kubectl"
alias find="fdfind"
alias grep="rg"
alias df="duf"
alias cp="rsync -ah --info=progress2"
alias mv="rsync -ah --info=progress2 --remove-source-files"
alias scp="rsync -avzP"

# OS-specific dotfiles sync
if [[ "$OSTYPE" == "darwin"* ]]; then
    alias dotsync="chezmoi update --force"
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    alias dotsync="sudo /usr/local/bin/chezmoi-sync"
fi

# Vi-mode & Keybindings
bindkey -v
bindkey -M viins 'jk' vi-cmd-mode
export KEYTIMEOUT=15

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line

# Plugins (antidote)
ANTIDOTE_DIR="${ZDOTDIR:-$HOME}/.antidote"
[[ -d "$ANTIDOTE_DIR" ]] || git clone --depth=1 https://github.com/mattmc3/antidote.git "$ANTIDOTE_DIR"

autoload -Uz compinit
compinit

source "$ANTIDOTE_DIR/antidote.zsh"
antidote load "${ZDOTDIR:-$HOME}/.zsh_plugins.txt"

# Integrations
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"
eval "$(direnv hook zsh)"